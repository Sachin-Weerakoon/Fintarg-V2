{
  "version": 2,
  "builds": [
    { "src": "frontend/package.json", "use": "@vercel/next" },
    { "src": "backend/package.json", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "backend/dist/app.js" },
    { "src": "/(.*)", "dest": "frontend/$1" }
  ],
  "outputDirectory": "frontend/.next"
}
